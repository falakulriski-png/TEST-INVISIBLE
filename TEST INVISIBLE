renderLoopConnection = RunService.RenderStepped:Connect(function(dt)
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if hum and hrp then
        hum.WalkSpeed = speedVal

        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
            if not bodyVel then
                bodyVel = Instance.new("BodyVelocity")
                bodyVel.MaxForce = Vector3.new(1e5, 0, 1e5)
                bodyVel.Velocity = Vector3.new(0,0,0)
                bodyVel.Parent = hrp
            end
            bodyVel.Velocity = hum.MoveDirection * speedVal * 2
        else
            if bodyVel then bodyVel:Destroy() bodyVel = nil end
        end

        if spin and alignAttachment then
            alignAttachment.WorldCFrame = alignAttachment.WorldCFrame * CFrame.Angles(0, math.rad(spinSpeed * 10 * dt), 0)
        end
    end

    -- Update Chams Distance Limit
    if chamsEnabled then
        local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        for plr, highlight in pairs(chamsTable) do
            if myHrp and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local targetHrp = plr.Character.HumanoidRootPart
                local dist = (myHrp.Position - targetHrp.Position).Magnitude
                highlight.Enabled = (dist <= chamsMaxDist)
            end
        end
    end

    -- Update Name ESP Distance Limit
    if nameEspEnabled then
        local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        for plr, billboard in pairs(nameTable) do
            if plr and plr.Character and billboard then
                local targetHrp = plr.Character:FindFirstChild("HumanoidRootPart")
                local label = billboard:FindFirstChildOfClass("TextLabel")
                if myHrp and targetHrp and label then
                    local dist = (myHrp.Position - targetHrp.Position).Magnitude
                    billboard.Enabled = (dist <= chamsMaxDist)
                    local distFloor = math.floor(dist)
                    label.Text = plr.DisplayName .. " (@" .. plr.Name .. ")\n[" .. distFloor .. "m]"
                end
            end
        end
    end
end)

