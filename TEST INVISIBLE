local function toggleSpin()
    spin = not spin
    btnSpin.Text = "Spin: ".. (spin and "ON" or "OFF")
    btnSpin.BackgroundColor3 = spin and Color3.fromRGB(30, 160, 80) or Color3.fromRGB(30, 32, 44)

    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if spin then
        hum.AutoRotate = false
        if not alignAttachment then
            alignAttachment = Instance.new("Attachment")
            alignAttachment.Name = "SpinAttachment"
            alignAttachment.Parent = hrp
        end
        if not alignOrientation then
