local function protect(v, char)
	if not AntiFling then return end
	local removed = false

	if v:IsA("BodyAngularVelocity") then
		removed = true
		v:Destroy()
	elseif v:IsA("BodyGyro") and v.MaxTorque ~= Vector3.new(8999999488,8999999488,8999999488) and v.D ~= 500 and v.D ~= 50 and v.P ~= 90000 then
		removed = true
		v:Destroy()
	elseif v:IsA("BodyVelocity") and v.MaxForce ~= Vector3.new(8999999488,8999999488,8999999488) and v.Velocity ~= Vector3.new(0,0,0) then
		removed = true
		v:Destroy()
	elseif v:IsA("BasePart") then
		v.ChildAdded:Connect(function(c) protect(c, char) end)
	end

	if removed and char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then hum.Sit = false hum.PlatformStand = false end
	end
end

local function setupCharacter(char)
	for _,v in pairs(char:GetDescendants()) do protect(v, char) end
	char.DescendantAdded:Connect(function(v) protect(v, char) end)
end

