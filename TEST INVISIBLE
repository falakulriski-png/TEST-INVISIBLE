local function setInvisible(state)
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not char or not hum or not hrp then return end

    if state then
        originalCFrame = hrp.CFrame
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Transparency = 0.7
            elseif v:IsA("Accessory") then
                for _, part in pairs(v:GetDescendants()) do
                    if part:IsA("BasePart") then part.Transparency = 0.7 end
                end
            end
        end

        task.spawn(function()
            while invisible and char and hrp do
                local cf = hrp.CFrame
                local camOffset = hum.CameraOffset
                local hidden = cf * CFrame.new(0, teleportHeight, 0)

                hrp.CFrame = hidden
                hum.CameraOffset = hidden:ToObjectSpace(CFrame.new(cf.Position)).Position

                RunService.RenderStepped:Wait()

                hrp.CFrame = cf
                hum.CameraOffset = camOffset
                task.wait()
            end
        end)
    else
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Transparency = 0
            elseif v:IsA("Accessory") then
                for _, part in pairs(v:GetDescendants()) do
                    if part:IsA("BasePart") then part.Transparency = 0 end
                end
            end
        end

        if originalCFrame then
            hrp.CFrame = originalCFrame + Vector3.new(0, 3, 0)
        end
    end
end

